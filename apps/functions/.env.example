# Local Emulator bypasses custom API App Check verification. Staging and production must set
# APP_ENV to the matching environment and APPCHECK_ENFORCEMENT_MODE=enforced.
APP_ENV=local
APPCHECK_ENFORCEMENT_MODE=disabled

# All limits are per authenticated UID and endpoint for this fixed window.
# Before staging enforcement, configure Firestore TTL for apiRateLimitBuckets.expireAt.
# Also configure Firestore TTL for adminContentPublishIdempotency.expireAt before cloud apply.
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_ACCOUNT_DELETION_MAX=3
API_RATE_LIMIT_ADMIN_MUTATION_MAX=10
API_RATE_LIMIT_COMPLETION_MAX=20
API_RATE_LIMIT_ENROLLMENT_MAX=10
API_RATE_LIMIT_PLAYGROUND_CONFIG_MAX=20
API_RATE_LIMIT_PLAYGROUND_RUN_MAX=10
API_RATE_LIMIT_PLAYGROUND_SESSION_MAX=10
API_RATE_LIMIT_QUIZ_ATTEMPT_MAX=10
API_RATE_LIMIT_QUIZ_SUBMISSION_MAX=5
