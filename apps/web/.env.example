# Local development defaults use Firebase Emulator. Copy to apps/web/.env.local only when you
# need to override these values.
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_USE_DATA_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-ml-learning-local
VITE_APP_ENV=local

# Keep this empty for Emulator use. Staging/production require a public reCAPTCHA Enterprise site key.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local/staging only. Never set this in production or commit a real token.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Production/staging cloud Firebase config is public Firebase web app config, but it is
# environment-specific. Do not commit populated .env.local files.
# VITE_FIREBASE_USE_EMULATOR=false
# VITE_FIREBASE_API_KEY=replace-with-public-web-api-key
# VITE_FIREBASE_APP_ID=replace-with-public-web-app-id
# VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# VITE_FIREBASE_STORAGE_BUCKET=replace-with-storage-bucket
# VITE_APP_ENV=staging
# VITE_FIREBASE_APPCHECK_SITE_KEY=replace-with-public-app-check-site-key
