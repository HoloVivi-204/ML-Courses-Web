{
  "name": "@ml-path/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @ml-path/contracts build",
    "pretest": "pnpm --filter @ml-path/contracts build",
    "pretypecheck": "pnpm --filter @ml-path/contracts build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:performance": "pnpm run build",
    "test:performance": "node scripts/check-performance-budget.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@libsvm-js/libsvm-js": "0.2.5",
    "@ml-path/contracts": "workspace:*",
    "@tensorflow/tfjs-backend-cpu": "4.22.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@tensorflow/tfjs-layers": "4.22.0",
    "antd": "^6.5.1",
    "firebase": "^12.16.0",
    "i18next": "^26.3.6",
    "katex": "^0.17.0",
    "lucide-react": "^1.25.0",
    "ml-cart": "2.1.1",
    "ml-hclust": "4.0.0",
    "ml-kmeans": "7.0.1",
    "ml-knn": "3.0.0",
    "ml-naivebayes": "4.0.0",
    "ml-pca": "4.1.1",
    "ml-random-forest": "2.1.0",
    "plotly.js-cartesian-dist-min": "3.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
