{
  "name": "ml-courses-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "pnpm --filter @ml-path/web dev",
    "build": "pnpm -r --workspace-concurrency=1 --filter \"!ml-courses-web\" --if-present build",
    "test": "pnpm -r --workspace-concurrency=1 --filter \"!ml-courses-web\" --if-present test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 --filter \"!ml-courses-web\" --if-present test:coverage",
    "pretest:e2e": "pnpm firebase:build",
    "test:e2e": "node firebase/emulator-seed/dist/run-emulators.js e2e",
    "test:performance": "pnpm --filter @ml-path/web test:performance",
    "typecheck": "pnpm -r --workspace-concurrency=1 --filter \"!ml-courses-web\" --if-present typecheck",
    "lint": "pnpm -r --workspace-concurrency=1 --filter \"!ml-courses-web\" --if-present lint",
    "format:check": "prettier --check package.json pnpm-workspace.yaml firebase.json && prettier --check .firebaserc --parser json && pnpm -r --workspace-concurrency=1 --filter \"!ml-courses-web\" --if-present format:check",
    "firebase:build": "pnpm --filter @ml-path/functions --filter @ml-path/emulator-seed build",
    "firebase:indexes:validate": "pnpm --filter @ml-path/emulator-seed build && pnpm --filter @ml-path/emulator-seed validate:indexes",
    "firebase:migrations:validate": "pnpm --filter @ml-path/functions build && node tools/migrations/20260810-release-one-published-learner-content.mjs --dry-run",
    "prefirebase:validate": "pnpm firebase:build",
    "firebase:validate": "node firebase/emulator-seed/dist/validate-environment.js",
    "prefirebase:emulators:start": "pnpm firebase:build",
    "firebase:emulators:start": "node firebase/emulator-seed/dist/run-emulators.js start",
    "prefirebase:friend-demo:start": "pnpm firebase:build",
    "firebase:friend-demo:start": "node firebase/emulator-seed/dist/run-hybrid-demo-emulators.js",
    "prefirebase:emulators:seed": "pnpm firebase:build",
    "firebase:emulators:seed": "node firebase/emulator-seed/dist/seed-emulators.js",
    "prefirebase:friend-demo:seed": "pnpm firebase:build",
    "firebase:friend-demo:seed": "node firebase/emulator-seed/dist/seed-hybrid-demo.js",
    "prefirebase:emulators:verify": "pnpm firebase:build",
    "firebase:emulators:verify": "node firebase/emulator-seed/dist/run-emulators.js verify",
    "analytics:aggregate": "pnpm --filter @ml-path/functions analytics:aggregate"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "firebase-tools": "^15.24.0",
    "prettier": "^3.9.5"
  }
}
